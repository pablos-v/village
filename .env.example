# Database
POSTGRES_PASSWORD=your_password

# AI
OPENROUTER_API_KEY=your_openrouter_key

# AI database role (read-only, для village_ai)
AI_ROLE_PASSWORD=your_ai_role_password
SPRING_AI_DATASOURCE_URL=jdbc:postgresql://postgres:5432/village
SPRING_AI_DATASOURCE_USERNAME=village_ai
SPRING_AI_DATASOURCE_PASSWORD=your_ai_role_password

# Брендинг — надписи в navbar и футере (опционально)
APP_BRAND=Village
APP_TAGLINE=Village — учёт сборов на нашей улице

# Domain (для nginx-proxy + letsencrypt)
DOMAIN_ADDRESS=village.yourdomain.com
ADMIN_EMAIL=your@email.com

# Image tag for docker-compose.prod.yml (выставляется CI)
IMAGE=ghcr.io/pablos-v/village:latest
