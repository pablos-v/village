# =====================================================================
# Village — переменные окружения для прода
# Скопируй в .env (cp .env.example .env), затем заполни. chmod 600 .env
# =====================================================================

# ---------- Основная БД (Postgres в нашем docker-compose) ----------
# url/username фиксированы для compose; пароль придумай длинный
POSTGRES_PASSWORD=replace_me_long_random
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/village
SPRING_DATASOURCE_USERNAME=village
SPRING_DATASOURCE_PASSWORD=replace_me_long_random          # тот же что POSTGRES_PASSWORD

# ---------- Отдельная БД-роль для AI ассистента (read-only) ----------
# Создаётся Liquibase changeset'ом 005-ai-role при первом старте
AI_ROLE_PASSWORD=replace_me_long_random
SPRING_AI_DATASOURCE_URL=jdbc:postgresql://postgres:5432/village
SPRING_AI_DATASOURCE_USERNAME=village_ai
SPRING_AI_DATASOURCE_PASSWORD=replace_me_long_random       # тот же что AI_ROLE_PASSWORD

# ---------- Пароли трёх системных аккаунтов (InMemoryUserDetailsManager) ----------
# user — общий пароль для жителей (вводят на витрине /welcome)
# operator/admin — для оператора и админа (вход через /login-operator)
APP_SECURITY_ADMIN_PASSWORD=replace_me_strong
APP_SECURITY_OPERATOR_PASSWORD=replace_me_strong
APP_SECURITY_USER_PASSWORD=replace_me_memorable_for_residents

# ---------- OpenRouter (AI-ассистент) ----------
# Без ключа AI-чат вернёт 500. Получить: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace_me
# Опционально: переопределить дефолтную модель из application.yml
# AI_MODEL=qwen/qwen3-235b-a22b-2507

# ---------- Брендинг (опционально, есть дефолты в application.yml) ----------
# APP_BRAND=Village
# APP_TAGLINE=Village — учёт сборов на нашей улице

# ---------- Образ Docker (CI выставляет автоматически) ----------
IMAGE=ghcr.io/pablos-v/village:latest

# ---------- Только для КАНОНИЧЕСКОГО docker-compose.prod.yml ----------
# Эти переменные нужны nginx-proxy + letsencrypt-companion внутри compose.
# Для docker-compose.merc.yml (FastPanel / внешний nginx) они НЕ нужны —
# SSL и проксирование делает внешний nginx, оставь закомментированными.
# DOMAIN_ADDRESS=village.example.com
# ADMIN_EMAIL=admin@example.com
