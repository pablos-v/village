<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="006-seed-event-initial-balance" author="village">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM village.events WHERE name = 'Остаток от прежних сборов'
            </sqlCheck>
        </preConditions>
        <insert tableName="events" schemaName="village">
            <column name="name" value="Остаток от прежних сборов"/>
            <column name="cost" valueNumeric="0"/>
        </insert>
    </changeSet>

    <changeSet id="006-seed-event-general" author="village">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM village.events WHERE name = 'На общие нужды'
            </sqlCheck>
        </preConditions>
        <insert tableName="events" schemaName="village">
            <column name="name" value="На общие нужды"/>
            <column name="cost" valueNumeric="0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
