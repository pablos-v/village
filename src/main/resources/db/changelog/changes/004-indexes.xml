        <createIndex indexName="idx_payment_household" tableName="payment" schemaName="village">
            <column name="hh_id"/>
        </createIndex>
        <createIndex indexName="idx_payment_events" tableName="payment" schemaName="village">
            <column name="evnt_id"/>
        </createIndex>
        <createIndex indexName="idx_payment_paydate" tableName="payment" schemaName="village">
            <column name="paydate"/>
        </createIndex>
        <createIndex indexName="idx_expense_events" tableName="expense" schemaName="village">
