{
  "name": "village",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/village",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "git config --global --add safe.directory /workspaces/village",
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-xml",
        "sonarsource.sonarlint-vscode",
        "ms-azuretools.vscode-docker",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "java.formatOnSave": true,
        "[java]": {
          "editor.defaultFormatter": "redhat.java"
        }
      }
    }
  }
}
